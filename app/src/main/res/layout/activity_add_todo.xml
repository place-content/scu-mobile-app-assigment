<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addTodoView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.AddTodoActivity">

    <!-- 왼쪽 위 < 버튼 = 취소하고 목록으로 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/title_add" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_title"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1">

                <!-- 추가 화면에 들어오면 바로 제목을 입력할 수 있게 -->
                <requestFocus />
            </EditText>

            <!-- 제목 없이 비활성 저장 버튼을 눌렀을 때만 보임 -->
            <TextView
                android:id="@+id/tvTitleError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/msg_title_required"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="@string/hint_note"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:minLines="3" />

            <EditText
                android:id="@+id/etDue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="@string/hint_due"
                android:importantForAutofill="no"
                android:inputType="none"
                android:maxLines="1" />

            <!-- 저장 버튼이 비활성이면 터치가 이 영역으로 넘어옴 → 빈 필수 칸을 빨갛게 표시 -->
            <FrameLayout
                android:id="@+id/saveButtonArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_save" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
