# 팀 전체 코드 스타일 (Android Studio, ktlint가 자동으로 읽음)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 120

[*.md]
# Markdown 줄 끝 공백 2칸 = 줄바꿈이라 지우지 않음
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
